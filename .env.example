# Copy to .env (or run `make init`) and edit as needed.
# All variables are optional — defaults shown.

# --- Image source ---------------------------------------------------------
REGISTRY=janez87
SPARK_TAG=latest
JUPYTERLAB_TAG=latest

# --- Spark cluster sizing -------------------------------------------------
WORKERS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
SPARK_DRIVER_MEMORY=1G
SPARK_EXECUTOR_MEMORY=1G

# --- JupyterLab -----------------------------------------------------------
# Leave JUPYTER_TOKEN blank for token-less local-lab use. Set a value to
# require it on every browser session.
JUPYTER_TOKEN=
JUPYTER_PORT=8888

# --- Spark UI ports -------------------------------------------------------
SPARK_MASTER_UI_PORT=8080

# --- Kafka overlay (only used with `make up-kafka`) -----------------------
CONFLUENT_TAG=7.5.3
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8084

# --- HDFS overlay (only used with `make up-hdfs`) -------------------------
HDFS_NAMENODE_UI_PORT=9870
HDFS_NAMENODE_RPC_PORT=9010
HDFS_DATANODE_UI_PORT=9864

# --- Optional dataset URL (consumed by scripts/fetch-data.sh) ------------
# DATA_URL=https://example.com/spark-practice-data.zip
